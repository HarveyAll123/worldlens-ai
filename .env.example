# WorldLens environment variables — PLACEHOLDERS ONLY. Never commit real values.
# See MANUAL_SETUP.md for where each value comes from.
#
# Browser (VITE_*) variables are compiled into the public JavaScript bundle: they are NOT secret.
# Put them in apps/web/.env.local (git-ignored) for development, or in your Pages build settings.
#
# Server variables belong to the Cloudflare Worker: use `wrangler secret put NAME` for secrets
# and apps/api/.dev.vars (git-ignored) for local development.

# ───────────────────────────── Browser (public) ─────────────────────────────
# MapTiler key for satellite imagery + terrain. Restrict it to your domains in MapTiler Cloud.
# Without it the globe uses Natural Earth II imagery bundled with CesiumJS.
VITE_MAPTILER_API_KEY=
# Base URL of the API. Leave empty to use same-origin /api (proxied by Vite in development).
VITE_API_BASE_URL=

# ───────────────────────────── Server (Worker) ──────────────────────────────
# PayPal Developer Dashboard → Apps & Credentials → Sandbox app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# This build only allows "sandbox".
PAYPAL_ENVIRONMENT=sandbox
# Webhook ID shown after you add the webhook URL in the sandbox app (used for signature verification).
PAYPAL_WEBHOOK_ID=

# AI assistant. Optional: without any key the rule-based offline assistant is used.
# Recommended, free: Google Gemini — aistudio.google.com → Get API key (no billing needed).
# Chosen automatically when set; models default to the fast free Flash-Lite with fallbacks.
GEMINI_API_KEY=
# Or Anthropic Console → API keys (paid).
ANTHROPIC_API_KEY=
# Alternatively, any OpenAI-compatible Chat Completions gateway (e.g. OpenCode Go + DeepSeek).
# Set AI_PROVIDER=openai and provide OPENCODE_API_KEY (or OPENAI_API_KEY).
# AI_PROVIDER=openai
# OPENCODE_API_KEY=
# AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
# AI_MODEL_STRONG=deepseek-v4.1-flash
# AI_MODEL_FAST=deepseek-v4.1-flash
# Model tiers (fast = classification/summaries, strong = agent/reasoning). Leave empty for the
# provider's defaults (Gemini: gemini-flash-lite-latest; Anthropic: claude-haiku-5-5 / claude-opus-5-5).
AI_MODEL_FAST=
AI_MODEL_STRONG=
# Hard daily spend cap (USD, per Worker isolate) and per-client request limit.
AI_DAILY_BUDGET_USD=5
AI_REQUESTS_PER_MINUTE=8

# Neon (serverless PostgreSQL + PostGIS). SERVER-ONLY secrets — never expose to the browser.
# DATABASE_URL: Neon console → Connect → pooled connection string for the least-privilege
# worldlens_app role. Optional: without it the API keeps live news and payments in memory.
# The Worker accepts only Neon hosts (*.neon.tech); `pnpm dev:node` also accepts any other
# PostgreSQL + PostGIS URL. An invalid or rejected URL disables the database: GET /api/health
# then shows provider "database" down (fixed message, never the URL) and repository "memory".
DATABASE_URL=
# The only variable `pnpm db:migrate` reads (it never falls back to DATABASE_URL): the owner
# role (e.g. neondb_owner) over the DIRECT (unpooled, no "-pooler" in the host) connection
# string. Not a Worker secret: keep it on your machine, preferably in apps/api/.dev.vars
# (git-ignored) rather than typed on the command line, where it lands in shell history.
MIGRATION_DATABASE_URL=

# News ingestion from GDELT (no key). Set to "false" to disable.
GDELT_ENABLED=true
# "files" (default): GDELT's 15-minute knowledge-graph files on data.gdeltproject.org — no
# rate limit. "api": the DOC 2.0 search API, which answers HTTP 429 to many shared/ISP IPs.
GDELT_SOURCE=files
# Named-publisher RSS feeds (fixed list in apps/api/src/providers/rss.ts, no key).
# Default off; set "true" to enable.
RSS_ENABLED=false
# Optional custom queries separated by "||" (with GDELT_SOURCE=files their words are matched
# against headlines, e.g. (earthquake OR flood OR "coast guard")).
GDELT_QUERIES=

# Comma-separated origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of the web app (PayPal return/cancel URLs).
PUBLIC_APP_URL=http://localhost:5173
# Bearer token for POST /api/ingest/run (manual ingestion trigger).
INGEST_TOKEN=

# Optional overrides
# HISTORICAL_BASEMAPS_BASE_URL=http://127.0.0.1:5173/vendor/historical-basemaps/
# WIKIPEDIA_USER_AGENT=WorldLens/0.1 (https://your-domain.example; contact@your-domain.example)

# Optional: World Historical Gazetteer token (reserved for the gazetteer provider; not used yet).
WHG_API_TOKEN=

# Cloudflare R2 is configured as a binding in apps/api/wrangler.toml (GEO_CACHE), not as a variable.
