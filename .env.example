# WorldLens environment variables — PLACEHOLDERS ONLY. Never commit real values.
# See MANUAL_SETUP.md for where each value comes from.
#
# Browser (VITE_*) variables are compiled into the public JavaScript bundle: they are NOT secret.
# Put them in apps/web/.env.local (git-ignored) for development, or in your Pages build settings.
#
# Server variables belong to the Cloudflare Worker: use `wrangler secret put NAME` for secrets
# and apps/api/.dev.vars (git-ignored) for local development.

# ───────────────────────────── Browser (public) ─────────────────────────────
# MapTiler key for satellite imagery + terrain. Restrict it to your domains in MapTiler Cloud.
# Without it the globe uses Natural Earth II imagery bundled with CesiumJS.
VITE_MAPTILER_API_KEY=
# Base URL of the API. Leave empty to use same-origin /api (proxied by Vite in development).
VITE_API_BASE_URL=

# ───────────────────────────── Server (Worker) ──────────────────────────────
# PayPal Developer Dashboard → Apps & Credentials → Sandbox app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# This build only allows "sandbox".
PAYPAL_ENVIRONMENT=sandbox
# Webhook ID shown after you add the webhook URL in the sandbox app (used for signature verification).
PAYPAL_WEBHOOK_ID=

# Anthropic Console → API keys. Optional: without it the rule-based offline assistant is used.
ANTHROPIC_API_KEY=
# Cost-aware model tiers (fast = classification/summaries, strong = agent/reasoning).
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_STRONG=claude-opus-5-5
# Hard daily spend cap (USD, per Worker isolate) and per-client request limit.
AI_DAILY_BUDGET_USD=5
AI_REQUESTS_PER_MINUTE=8

# Supabase → Project settings → API. The service-role key is SERVER-ONLY (bypasses RLS).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# News ingestion (GDELT DOC 2.0 API — no key). Set to "false" to disable.
GDELT_ENABLED=true
# Optional custom queries separated by "||".
GDELT_QUERIES=

# Comma-separated origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of the web app (PayPal return/cancel URLs).
PUBLIC_APP_URL=http://localhost:5173
# Bearer token for POST /api/ingest/run (manual ingestion trigger).
INGEST_TOKEN=

# Optional overrides
# HISTORICAL_BASEMAPS_BASE_URL=http://127.0.0.1:5173/vendor/historical-basemaps/
# WIKIPEDIA_USER_AGENT=WorldLens/0.1 (https://your-domain.example; contact@your-domain.example)

# Optional: World Historical Gazetteer token (reserved for the gazetteer provider; not used yet).
WHG_API_TOKEN=

# Cloudflare R2 is configured as a binding in apps/api/wrangler.toml (GEO_CACHE), not as a variable.
