# WorldLens API settings on the server: /etc/worldlens/api.env (owner root, mode 600).
# setup.sh copies this file there, fills in the address and two fresh secrets; add the rest with
#   sudoedit /etc/worldlens/api.env
# One KEY=value per line. No quotes, and no comments after a value (they would become part of it).
# Never commit the filled-in file.

# The site's address (set by setup.sh).
PUBLIC_APP_URL=https://YOUR-DOMAIN
ALLOWED_ORIGINS=https://YOUR-DOMAIN
API_PORT=8787

# The site's data files, read by the API from the local copy Caddy serves (not over the internet).
PUBLISHER_DIRECTORY_URL=http://127.0.0.1:8080/data/publishers/
PLACE_NAMES_URL=http://127.0.0.1:8080/data/places/names.json

# Generated by setup.sh for this server only (sessions; the 15-minute news timer).
BETTER_AUTH_SECRET=
INGEST_TOKEN=

# Neon: the POOLED connection string of the worldlens_app role (never the owner's).
DATABASE_URL=

# AI (Gemini free tier).
GEMINI_API_KEY=
AI_DAILY_BUDGET_USD=5
AI_REQUESTS_PER_MINUTE=8

# Google sign-in (OAuth client; redirect URI https://YOUR-DOMAIN/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Account emails through Brevo (MAIL_FROM: the sender verified in Brevo).
MAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=WorldLens

# PayPal sandbox (Take Action demo).
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Live news from GDELT (read every 15 minutes by worldlens-ingest.timer).
GDELT_ENABLED=true
NODE_ENV=production
