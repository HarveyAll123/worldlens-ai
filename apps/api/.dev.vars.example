# Copy to apps/api/.dev.vars (git-ignored); read by `wrangler dev`, `pnpm dev:node` and
# `pnpm db:migrate`. Placeholders only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
PUBLIC_APP_URL=http://localhost:5173
ANTHROPIC_API_KEY=
# Alternative AI provider: any OpenAI-compatible Chat Completions endpoint (e.g. OpenCode Go).
# Set AI_PROVIDER=openai and provide OPENCODE_API_KEY (or OPENAI_API_KEY). AI_BASE_URL must
# include the version segment. Defaults: base URL https://opencode.ai/inference/go/openai/v1,
# models deepseek-v4.1-flash.
# AI_PROVIDER=openai
# OPENCODE_API_KEY=
# AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
# AI_MODEL_STRONG=deepseek-v4.1-flash
# AI_MODEL_FAST=deepseek-v4.1-flash
# Neon → Connect → pooled connection string for the worldlens_app role (see MANUAL_SETUP.md).
# `wrangler dev` accepts only Neon hosts (*.neon.tech); `pnpm dev:node` also accepts any other
# PostgreSQL + PostGIS URL (local or remote).
DATABASE_URL=
# Only for `pnpm db:migrate`, which reads this (or the environment) and never DATABASE_URL:
# owner role, direct (unpooled) connection string.
MIGRATION_DATABASE_URL=
INGEST_TOKEN=
