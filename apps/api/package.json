{
  "name": "@worldlens/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev --port 8787 --ip 127.0.0.1",
    "dev:node": "tsx watch src/node-server.ts",
    "start:node": "tsx src/node-server.ts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node -e \"require('fs').mkdirSync('../web/dist',{recursive:true})\" && wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@neondatabase/serverless": "1.2.0",
    "@worldlens/shared": "workspace:*",
    "better-auth": "1.7.18",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@hono/node-server": "2.1.5",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "wrangler": "4.151.0"
  }
}
