{
  "name": "worldlens-ai",
  "private": true,
  "version": "0.1.0",
  "description": "WorldLens \u2014 a temporal world-intelligence globe: live events, history, changing borders, AI-assisted exploration and PayPal-powered action.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm --filter @worldlens/api dev\" \"pnpm --filter @worldlens/web dev\"",
    "dev:node": "concurrently -k -n api,web -c blue,green \"pnpm --filter @worldlens/api dev:node\" \"pnpm --filter @worldlens/web dev\"",
    "build": "pnpm -r build",
    "deploy": "pnpm --filter @worldlens/web build && pnpm --filter @worldlens/api run deploy",
    "deploy:free": "pnpm --filter @worldlens/web build && pnpm --filter @worldlens/api exec wrangler deploy --config ../../deploy/free/wrangler.toml",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash scripts/test-migrations.sh",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:merge-duplicates": "tsx scripts/merge-duplicate-news.ts",
    "test:e2e": "playwright test",
    "verify:paypal": "tsx scripts/verify-paypal-oauth.ts",
    "data:build": "tsx scripts/build-geodata.ts",
    "data:battles": "tsx scripts/build-battles.ts",
    "data:ohm": "tsx scripts/build-ohm-borders.ts",
    "data:flags": "tsx scripts/build-flags.ts",
    "data:succession": "tsx scripts/build-succession.ts",
    "data:audit-borders": "tsx scripts/audit-ohm-borders.ts",
    "data:fetch-basemaps": "tsx scripts/fetch-historical-basemaps.ts",
    "data:publishers": "tsx scripts/build-publishers.ts",
    "data:places": "tsx scripts/build-place-names.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
